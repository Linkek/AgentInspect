{
  "name": "agent-inspect",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "dotenv -e .env -- pnpm tauri dev",
    "tauri:dev:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev.ps1",
    "tauri:build": "pnpm tauri build",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-versions.mjs",
    "sync-versions": "node scripts/sync-versions.mjs",
    "release:git-tag": "node scripts/tag-release.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.6.0",
    "@mui/material": "^9.6.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "recharts": "^3.11.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.2",
    "dotenv-cli": "^11.1.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
